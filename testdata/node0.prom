# TYPE straum_proposals_committed_total counter
straum_proposals_committed_total 1
# HELP straum_proposals_given_up_total Own proposals shown lost by a later one committing first.
# TYPE straum_proposals_given_up_total counter
straum_proposals_given_up_total 0
# HELP straum_outbox_entries Own proposals accepted and awaiting commit.
# TYPE straum_outbox_entries gauge
straum_outbox_entries 0
# HELP straum_outbox_sent Of those, sent and awaiting their slot's decision.
# TYPE straum_outbox_sent gauge
straum_outbox_sent 0
# HELP straum_outbox_bytes Bytes the outbox holds (bodies and properties).
# TYPE straum_outbox_bytes gauge
straum_outbox_bytes 0
# HELP straum_outbox_capacity The outbox's bound: max_queue / voters.
# TYPE straum_outbox_capacity gauge
straum_outbox_capacity 341
# HELP straum_outbox_resent_total Own proposals sent again after their slot closed.
# TYPE straum_outbox_resent_total counter
straum_outbox_resent_total 0
# HELP straum_forwards_refused_total Other nodes' forwards this sequencer's full or sealed queue refused.
# TYPE straum_forwards_refused_total counter
straum_forwards_refused_total 0
# HELP straum_forwards_dropped_total Own proposals' forwards dropped at a full link queue: lost, given up once a later one commits.
# TYPE straum_forwards_dropped_total counter
straum_forwards_dropped_total 0
