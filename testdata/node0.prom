# TYPE straum_progress_age_seconds gauge
straum_progress_age_seconds 2.106694417
# HELP straum_catching_up 1 while lag is above 0. An indicator only: a healthy replica under load is a few positions behind too; telling catch-up from normal replication takes lag, rate and age together.
# TYPE straum_catching_up gauge
straum_catching_up 0
# HELP straum_serving 1 once this node's gateway takes clients: its own reset is applied.
# TYPE straum_serving gauge
straum_serving 1
